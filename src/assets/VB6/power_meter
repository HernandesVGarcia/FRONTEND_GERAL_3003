Private Function PREENCHE_POWER_METER()



If TABLE <> "DIO" Then Text_NIVEL.Caption = "--.-- dBm": Text_metragem.Text = Int(METRAGEM) & " metros": Exit Function
Text_metragem.Text = Int(METRAGEM) & " metros"

Text_ATENUAÇAO.Caption = ATENUACAO + ((METRAGEM / 1000) * 0.23)

Text_ATENUAÇAO.Caption = Format$(Text_ATENUAÇAO.Caption, "00.00")


If NIVEL = -399 Then Text_NIVEL.Caption = "OFF": Exit Function

Text_NIVEL.Caption = NIVEL - Text_ATENUAÇAO.Caption

Text_NIVEL.Caption = Format$(Text_NIVEL.Caption, "00.00") & "dBm"






End Function

