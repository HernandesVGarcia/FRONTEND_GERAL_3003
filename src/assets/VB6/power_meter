Private Sub Form_carrega()

Dim rs_cabo_sel As Recordset


If InStr(1, id_cabo_selecionado, "cabo", 1) Then GoTo Cabo Else GoTo splitter

'------------
Cabo:
'------------
If Right(id_cabo_selecionado, 1) = "A" Then TABELA = "cabopa": TABLE = "caboa_"
If Right(id_cabo_selecionado, 1) = "B" Then TABELA = "cabopb": TABLE = "cabob_"

Set rs_cabo_sel = VIEW_PROJETO_CONEXOES_CAIXA_VISIO_CADASTRO.connMETA.Execute("select capacidade,ID_META from " & TABELA & " where id_visio ='" & id_cabo_selecionado & "';")

    ID_META_CABO_SELECIONADO = rs_cabo_sel!ID_META


Combo_fibra.Clear

For i = 1 To rs_cabo_sel!CAPACIDADE

    Combo_fibra.AddItem (i)

Next i


Exit Sub

'------------
splitter:
'------------

Combo_fibra.Clear

ID_META_CABO_SELECIONADO = id_cabo_selecionado

Combo_fibra.AddItem ("Entrada")
Combo_fibra.AddItem ("Saida")




End Sub

